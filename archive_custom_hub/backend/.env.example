# ==============================================================================
# Configurações da Aplicação
# ==============================================================================
APP_ENV=development
APP_NAME="Hub Financeiro"
APP_SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# ==============================================================================
# Banco de Dados (PostgreSQL Assíncrono)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hub_financeiro

# ==============================================================================
# Integração Pluggy (Open Finance)
# Obtenha em: https://dashboard.pluggy.ai/
# ==============================================================================
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here
PLUGGY_WEBHOOK_SECRET=your_custom_webhook_secret_here

# ==============================================================================
# Autenticação e Sessões (JWT & Cookies)
# ==============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
